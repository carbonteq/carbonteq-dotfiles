{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") }}

#!/usr/bin/env bash
{{ template "scripts_library.sh" . }}

# 1. Detect actual mise location
if [ -f "$HOME/.local/bin/mise" ]; then
    MISE_BIN="$HOME/.local/bin/mise"
elif [ -f "$HOME/.local/share/mise/bin/mise" ]; then
    MISE_BIN="$HOME/.local/share/mise/bin/mise"
else
    MISE_BIN="mise" # Fallback to PATH
fi

if ! command_exists mise && [ ! -f "$MISE_BIN" ]; then
    log "Action: Installing mise..." 
    curl https://mise.jdx.dev/install.sh | sh
    
    # Redetect after install
    [ -f "$HOME/.local/bin/mise" ] && MISE_BIN="$HOME/.local/bin/mise"
    
    # 2. Add to shell profile for future sessions
    SHELL_PROFILE="$([ -f "$HOME/.zshrc" ] && echo "$HOME/.zshrc" || echo "$HOME/.bashrc")"
    if ! grep -qs "mise activate" "$SHELL_PROFILE"; then
        log "Action: Adding mise activation to $SHELL_PROFILE"
        echo "export PATH=\"$(dirname "$MISE_BIN"):\$PATH\"" >> "$SHELL_PROFILE"
        echo "eval \"\$($MISE_BIN activate bash)\"" >> "$SHELL_PROFILE"
    fi
else
    skip "mise is already installed at $MISE_BIN"
fi

# 3. Use the absolute path to execute commands in this session
log "Action: Syncing global runtimes..."

# Update PATH for the current script execution
export PATH="$(dirname "$MISE_BIN"):$PATH"

"$MISE_BIN" use --global node@lts 
"$MISE_BIN" use --global python@latest 
"$MISE_BIN" use --global pnpm@latest 
"$MISE_BIN" use --global bun@latest 

ok "Mise runtimes synced using $MISE_BIN"


{{ end -}}