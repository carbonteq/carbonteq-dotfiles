{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") }}

#!/usr/bin/env bash
{{ template "scripts_library.sh" . }}

if ! command_exists cargo; then
    log "Installing Rust..." 
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y 
    
    # Source it for the current script session
    . "$HOME/.cargo/env"
    
    # Ensure it's added to your shell profile for future sessions
    SHELL_PROFILE="$([ -f "$HOME/.zshrc" ] && echo "$HOME/.zshrc" || echo "$HOME/.bashrc")"
    if ! grep -qs "cargo/env" "$SHELL_PROFILE"; then
        echo '. "$HOME/.cargo/env"' >> "$SHELL_PROFILE"
        log "Added cargo to $SHELL_PROFILE"
    fi
else
    # Even if cargo exists, ensure the current script session has it in PATH
    . "$HOME/.cargo/env" 2>/dev/null || true
    skip "Rust (cargo)"
fi

# Format: "crate-name:binary-name"
RUST_TOOLS="ripgrep:rg fd-find:fd bat:bat eza:eza zoxide:zoxide xh:xh zellij:zellij gitui:gitui starship:starship du-dust:dust dua-cli:dua hyperfine:hyperfine git-delta:delta ripgrep_all:rga tokei:tokei just:just mask:mask mprocs:mprocs fselect:fselect bacon:bacon cargo-info:cargo-info wiki-tui:wiki-tui rusty-man:rusty-man kondo:kondo bob-nvim:bob" 

for entry in $RUST_TOOLS; do
    pkg="${entry%%:*}"
    bin="${entry##*:}"
    
    if ! command_exists "$bin"; then
        log "Installing $pkg..."

        if [["$pkg" == "rusty-man" ]]; then
            cargo install "$pkg" --locked --quiet || warn "Failed to install $pkg"
        else
            cargo install "$pkg" --quiet || warn "Failed to install $pkg"
        fi
    else
        skip "$pkg"
    fi
done

# --- Homebrew & evil-helix ---
# Ensure brew is in the path for this session if it was just installed
if [ -d "/home/linuxbrew/.linuxbrew/bin" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -d "$HOME/.linuxbrew/bin" ]; then
    eval "$($HOME/.linuxbrew/bin/brew shellenv)"
fi

if command_exists brew; then
    if ! command_exists hx; then
        log "Installing evil-helix via Homebrew..."
        # evil-helix usually provides the 'hx' binary
        brew install evil-helix && ok "evil-helix installed" || warn "Failed to install evil-helix"
    else
        skip "evil-helix (hx)"
    fi
else
    warn "Homebrew not found; skipping evil-helix installation."
fi


ok "Rust (cargo) and expanded CLI toolkit synced"

{{ end -}}