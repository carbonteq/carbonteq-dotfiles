{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
{{ template "scripts_library.sh" . }}

log "--- Starting Shell Installation Sequence ---"

# Fish Shell
if ! command_exists fish; then
    log "Action: Installing Fish Shell..."
    sudo apt update && sudo apt install -y fish
    if [ $? -eq 0 ]; then
        ok "Fish Shell successfully installed."
    else
        error "Failed to install Fish Shell."
    fi
else
    skip "Fish shell already present."
fi

# Nushell
if ! command_exists nu; then
    log "Action: Installing Nushell via Cargo (this may take a few minutes)..."
    
    # Check if cargo is available in the current session
    if command_exists cargo; then
        cargo install nu
        if [ $? -eq 0 ]; then
            ok "Nushell successfully installed via Cargo."
        else
            error "Cargo failed to build Nushell."
        fi
    else
        warn "Cargo not found. Skipping Nushell install. Run your Rust script first!"
    fi
else
    skip "Nushell already present."
fi

# Alacritty
if ! command_exists alacritty; then
    log "Action: Adding Alacritty PPA and installing..."
    sudo add-apt-repository ppa:aslatter/ppa -y && sudo apt update
    sudo apt install -y alacritty
    if [ $? -eq 0 ]; then
        ok "Alacritty successfully installed."
    else
        error "Failed to install Alacritty."
    fi
else
    skip "Alacritty already present."
fi

ok "All Linux Shells processed."

{{ end -}}